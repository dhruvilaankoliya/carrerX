# Database Configuration (SQLite default for zero-config local dev, can be switched to PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET="careerx_super_secret_production_jwt_key_2026_secure"

# Optional LLM API Keys (OpenAI or Gemini).
# If not provided, CareerX uses its built-in heuristic/deterministic fallback engine so it works 100% locally out-of-the-box!
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Application Environment
NODE_ENV="development"
PORT="3000"
