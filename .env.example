# Database Configuration (SQLite default for zero-config local dev, can be switched to PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET="careerx_super_secret_production_jwt_key_2026_secure"

# ==============================================================================
# LLM API Keys (Free Tier Supported)
# CareerX automatically prioritizes: Gemini -> Groq -> OpenRouter -> OpenAI -> Local Fallback
# ==============================================================================

# 1. Google Gemini API (100% Free API Key via Google AI Studio)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 2. Groq API (Fast, Free Tier API via GroqCloud for Llama 3.3 70B)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=""

# 3. OpenRouter API (Supports Free Models like Gemini Flash, Llama 3.3 Free, DeepSeek R1 Free)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# 4. OpenAI API (ChatGPT - gpt-4o-mini / gpt-3.5-turbo)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Application Environment
NODE_ENV="development"
PORT="3000"
